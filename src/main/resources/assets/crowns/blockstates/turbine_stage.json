{
  "multipart": [
    {
      "when": {
        "casing": "true",
        "facing": "down"
      },
      "apply": {
        "model": "crowns:block/turbine/casing",
        "x": 90
      }
    },
    {
      "when": {
        "casing": "true",
        "facing": "up"
      },
      "apply": {
        "model": "crowns:block/turbine/casing",
        "x": 270
      }
    },
    {
      "when": {
        "casing": "true",
        "facing": "north"
      },
      "apply": {
        "model": "crowns:block/turbine/casing"
      }
    },
    {
      "when": {
        "casing": "true",
        "facing": "south"
      },
      "apply": {
        "model": "crowns:block/turbine/casing",
        "y": 180
      }
    },
    {
      "when": {
        "casing": "true",
        "facing": "east"
      },
      "apply": {
        "model": "crowns:block/turbine/casing",
        "y": 90
      }
    },
    {
      "when": {
        "casing": "true",
        "facing": "west"
      },
      "apply": {
        "model": "crowns:block/turbine/casing",
        "y": 270
      }
    },
    {
      "when": {
        "casing": "false"
      },
      "apply": {
        "model": "crowns:block/turbine/none"
      }
    }
  ]
}